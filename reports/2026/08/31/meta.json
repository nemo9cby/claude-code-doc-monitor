u4e0e\u5408\u5e76\u89c4\u5219\uff0c\u4ee5\u53ca\u5b50\u4ee3\u7406\u6a21\u578b\u9009\u62e9\u7684\u4f18\u5148\u7ea7\u987a\u5e8f\uff08\u73af\u5883\u53d8\u91cf > \u4e3b\u4f1a\u8bdd\u6a21\u578b\uff09\u3002\n*   **Hooks \u4e0e\u6743\u9650\u903b\u8f91\uff1a** `PreToolUse` hook \u4e2d\u7684 `updatedInput` \u73b0\u5728\u660e\u786e\u6307\u51fa\uff0c\u6743\u9650\u89c4\u5219\u548cBash\u81ea\u52a8\u540e\u53f0\u68c0\u67e5\u5c06\u57fa\u4e8e**\u4fee\u6539\u540e**\u7684\u8f93\u5165\u6267\u884c\uff0c\u800c\u975e\u539f\u59cb\u8f93\u5165\u3002\n*   **\u89c4\u5219\u6392\u9664\u4e0e\u4ea4\u4e92\u7ec6\u8282\uff1a** \u6539\u8fdb\u4e86\u901a\u8fc7\u7b26\u53f7\u94fe\u63a5\u5f15\u7528\u7684\u89c4\u5219\u6587\u4ef6\u7684 `claudeMdExcludes` \u5339\u914d\u884c\u4e3a\uff1b\u5fae\u8c03\u4e86\u7ec8\u7aef\u7c98\u8d34\u5185\u5bb9\u7684\u6298\u53e0\u9608\u503c\u3002\n\n### \u5f71\u54cd\u7ea7\u522b\n\n**\u4e2d**\n\n**\u7406\u7531\uff1a** \u867d\u7136\u5927\u90e8\u5206\u66f4\u65b0\u4e3a\u6587\u6863\u6f84\u6e05\uff0c\u4f46 `PreToolUse` hook \u4e2d\u6743\u9650\u68c0\u67e5\u903b\u8f91\u7684\u53d8\u66f4\uff08\u4ece\u68c0\u67e5\u539f\u59cb\u8f93\u5165\u53d8\u4e3a\u68c0\u67e5\u4fee\u6539\u540e\u8f93\u5165\uff09\u5c5e\u4e8e\u884c\u4e3a\u53d8\u66f4\uff0c\u53ef\u80fd\u5f71\u54cd\u73b0\u6709\u7684\u5b89\u5168\u94a9\u5b50\u903b\u8f91\u3002\u6b64\u5916\uff0cKeychain \u7684\u964d\u7ea7\u5b58\u50a8\u903b\u8f91\u4e5f\u4f1a\u5f71\u54cd\u7279\u5b9a\u73af\u5883\u4e0b\u7684\u51ed\u8bc1\u6301\u4e45\u5316\u65b9\u5f0f\u3002\n\n### \u5f00\u53d1\u8005\u884c\u52a8\u9879\n\n*   **\u5ba1\u67e5 Hooks \u903b\u8f91\uff1a** \u68c0\u67e5\u81ea\u5b9a\u4e49 `PreToolUse` hooks\uff0c\u786e\u4fdd\u5b89\u5168\u7b56\u7565\u80fd\u6b63\u786e\u5904\u7406\u57fa\u4e8e `updatedInput` \u4fee\u6539\u540e\u7684\u53c2\u6570\uff0c\u800c\u975e\u539f\u59cb\u53c2\u6570\u3002\n*   **\u5173\u6ce8\u51ed\u8bc1\u5b58\u50a8\uff1a** \u82e5\u5728\u9501\u5b9a\u4e86 Keychain \u7684 SSH \u73af\u5883\u4e0b\u8fd0\u884c\uff0c\u9700\u6ce8\u610f\u51ed\u8bc1\u5c06\u5b58\u50a8\u5728 `~/.claude/.credentials.json` \u4e2d\uff0c\u800c\u975e Keychain\u3002\n*   **\u66f4\u65b0\u6392\u9664\u89c4\u5219\uff1a** \u5982\u679c\u4f7f\u7528\u7b26\u53f7\u94fe\u63a5\u5171\u4eab\u89c4\u5219\u6587\u4ef6\uff0c\u8bf7\u8c03\u6574 `claudeMdExcludes` \u6a21\u5f0f\uff0c\u786e\u4fdd\u8986\u76d6\u94fe\u63a5\u8def\u5f84\u6216\u76ee\u6807\u8def\u5f84\u3002\n*   **\u8c03\u6574\u9065\u6d4b\u914d\u7f6e\u4f4d\u7f6e\uff1a** \u5c06 `OTEL_LOG_RAW_API_BODIES` \u7b49\u9065\u6d4b\u53d8\u91cf\u79fb\u81f3\u7528\u6237\u6216\u6258\u7ba1\u8bbe\u7f6e\u5c42\uff0c\u56e0\u4e3a\u5176\u5728\u9879\u76ee/\u672c\u5730\u8bbe\u7f6e\u5c42\u5c06\u88ab\u5ffd\u7565\u3002\n*   **\u9a8c\u8bc1 Effort \u6301\u4e45\u5316\uff1a** \u6ce8\u610f `/effort` \u547d\u4ee4\u73b0\u5728\u4f1a\u6309\u6a21\u578b\u5c06\u914d\u7f6e\u4fdd\u5b58\u5230 `modelSettings` \u4e2d\uff0c\u800c\u975e\u5355\u4e00\u7684\u5168\u5c40 `effortLevel`\u3002", "reasoning": "\u7528\u6237\u5e0c\u671b\u6211\u5206\u6790\u4e00\u4efd\u6587\u6863\u53d8\u66f4\u96c6\uff0c\u6d89\u53ca 15 \u4e2a\u9875\u9762\uff0c\u5e76\u4ee5 Markdown \u683c\u5f0f\u63d0\u4f9b\u7b80\u6d01\u7684\u4e2d\u6587\u5206\u6790\u3002\n\u6211\u9700\u8981\u6db5\u76d6\uff1a\n1. \u6574\u4f53\u6458\u8981\uff081-2 \u53e5\u8bdd\uff09\n2. \u5173\u952e\u4e3b\u9898\uff08\u8981\u70b9\uff09\n3. \u5f71\u54cd\u7ea7\u522b\uff08\u4f4e/\u4e2d/\u9ad8/\u7834\u574f\u6027\uff09\u53ca\u5176\u7406\u7531\n4. \u5f00\u53d1\u8005\u884c\u52a8\u9879\uff08\u8981\u70b9\uff0c\u6700\u591a 5 \u6761\uff09\n\n\u8ba9\u6211\u4eec\u901a\u8bfb\u8fd9\u4e9b\u53d8\u66f4\uff0c\u770b\u770b\u53d1\u751f\u4e86\u4ec0\u4e48\u3002\n\n**\u53d8\u66f4\u5206\u6790\uff1a**\n\n1.  **cli-reference.md:** `--effort` \u6807\u5fd7\u73b0\u5728\u8986\u76d6 `modelSettings` \u548c `effortLevel`\u3002\u4ee5\u524d\u4ec5\u8986\u76d6 `effortLevel`\u3002\u8fd9\u662f\u4e00\u4e2a\u5c0f\u7684\u903b\u8f91\u6f84\u6e05/\u53d8\u66f4\u3002\n\n2.  **headless.md:** 401/403 \u9519\u8bef\u4e0a\u7684 API \u91cd\u8bd5\u884c\u4e3a\u3002\u5bf9\u4e8e\u4f7f\u7528 `apiKeyHelper` \u7684\u60c5\u51b5\uff0c\u5b83\u4f1a\u4f7f\u524d\u4e24\u6b21\u91cd\u8bd5\u4fdd\u6301\u9759\u9ed8\uff0c\u7136\u540e\u5f00\u59cb\u53d1\u51fa\u4e8b\u4ef6\u3002\u884c\u4e3a\u7565\u6709\u53d8\u66f4\u3002\n\n3.  **hooks.md:** `updatedInput` \u94a9\u5b50\u5b57\u6bb5\u6f84\u6e05\u3002\u5b83\u6307\u51fa\u5bf9\u8fd4\u56de\u7684\u8f93\u5165\u8bc4\u4f30\u6743\u9650\u89c4\u5219\u548c Bash \u81ea\u52a8\u540e\u53f0\u8d44\u683c\uff0c\u800c\u4e0d\u662f Claude \u53d1\u9001\u7684\u8f93\u5165\u3002\u8fd9\u662f\u4e00\u4e2a\u81f3\u5173\u91cd\u8981\u7684\u6f84\u6e05\uff0c\u53ef\u80fd\u4f1a\u5f71\u54cd\u57fa\u4e8e\u65e7\u903b\u8f91\u7f16\u5199\u7684\u94a9\u5b50\u903b\u8f91\u3002\n\n4.  **iam.md:**\n    *   \u5728\u672a\u521b\u5efa API \u5bc6\u94a5\u7684\u60c5\u51b5\u4e0b\u767b\u5f55\uff1a\u6dfb\u52a0\u4e86\u4e00\u8282\u5173\u4e8e\u4f7f\u7528 OAuth \u8f6e\u5ed3\u6587\u4ef6\u800c\u4e0d\u662f\u9759\u6001 API \u5bc6\u94a5\u767b\u5f55\u63a7\u5236\u53f0\u7684\u65b0\u529f\u80fd\u3002\u8fd9\u9700\u8981 v2.1.242\u3002\n    *   \u5982\u679c\u8bbe\u7f6e\u4e86 `forceLoginOrgUUID`\uff0c\u5c06\u56de\u9000\u5230\u521b\u5efa\u5bc6\u94a5\u3002\n    *   macOS Keychain \u884c\u4e3a\uff1a\u5982\u679c\u5199\u5165\u88ab\u62d2\u7edd\uff08\u4f8b\u5982 SSH \u4f1a\u8bdd\u4e2d\u9501\u5b9a\u7684 Keychain\uff09\uff0c\u5219\u56de\u9000\u5230 `~/.claude/.credentials.json`\u3002\n    *   \u5bf9 `forceLoginOrgUUID` \u7684\u5c0f\u6587\u672c\u8c03\u6574\u3002\n\n5.  **mcp.md:**\n    *   \u79fb\u9664\u4e86\u63d0\u5230\u201c\u672a\u6536\u5230\u8fdc\u7a0b\u914d\u7f6e\u7684\u90e8\u7f72\u201d\u4f5c\u4e3a\u65e0\u6548\u8f93\u5165\u67b6\u6784\u6392\u9664\u89e6\u53d1\u6761\u4ef6\u7684\u63cf\u8ff0\u3002\u73b0\u5728\u4f3c\u4e4e\u53ea\u662f\u666e\u904d\u8fdb\u884c\u6392\u9664\uff08\u9664\u975e\u529f\u80fd\u6807\u5fd7\u5df2\u5173\u95ed\uff1f\uff09\u3002\n    *   \u5b9e\u9645\u4e0a\uff0c\u7a0d\u540e\u5b83\u8bf4\u201cClaude Code \u901a\u8fc7\u4ece Anthropic \u83b7\u53d6\u7684\u529f\u80fd\u6807\u5fd7\u6765\u5f00\u542f\u6b64\u6392\u9664\u529f\u80fd\u3002\u5728\u2026\u2026\u6807\u5fd7\u83b7\u53d6\u88ab\u5173\u95ed\u7684\u90e8\u7f72\u4e2d\u2026\u2026\u5b83\u4ecd\u8fd0\u884c\u68c0\u67e5\u4f46\u53d1\u9001\u5de5\u5177\u67b6\u6784\u201d\u3002\u6240\u4ee5\uff0c\u5bf9\u4e8e\u79bb\u7ebf/\u6c14\u9699\u673a\u5668\u7684\u884c\u4e3a\u53d8\u66f4/\u6f84\u6e05\u3002\n    *   \u5173\u4e8e\u79bb\u7ebf\u90e8\u7f72\u884c\u4e3a\u7684\u663e\u8457\u6f84\u6e05\u3002\n\n6.  **memory.md:** \u6392\u9664\u901a\u8fc7\u7b26\u53f7\u94fe\u63a5\u8bbf\u95ee\u7684\u89c4\u5219\u6587\u4ef6\u7684 `claudeMdExcludes` \u884c\u4e3a\u53d8\u66f4\u3002\u4ee5\u524d\uff0c\u4f60\u9700\u8981\u5339\u914d\u94fe\u63a5\u76ee\u6807\u3002\u73b0\u5728\u5339\u914d\u4efb\u4e00\u8def\u5f84\u5373\u53ef\u6392\u9664\u6587\u4ef6\u3002\u8fd9\u4fee\u590d\u4e86\u7b26\u53f7\u94fe\u63a5\u7684\u4e00\u4e2a\u5c0f Bug/\u9057\u6f0f\u3002\n\n7.  **model-config.md:**\n    *   `default` \u6a21\u578b\u89e3\u6790\uff1a\u63d0\u53ca\u201cEnterprise pay-as-you-go\u201d\u88ab\u5408\u5e76\u5230\u901a\u7528\u7684\u201cEnterprise\u201d\u4e2d\u3002\n    *   \u52aa\u529b\u7ea7\u522b\uff08effort level\uff09\u89e3\u6790\uff1a\u5173\u4e8e\u9ed8\u8ba4\u6a21\u578b\u4e0e\u6301\u4e45\u5316\u8bbe\u7f6e\u4e0e\u6a21\u578b\u9ed8\u8ba4\u503c\u7684\u4f18\u5148\u7ea7\u987a\u5e8f\u7684\u663e\u8457\u6f84\u6e05\u3002\u89e3\u91ca\u4e86 `modelSettings` \u5982\u4f55\u4e0e `effortLevel` \u4ea4\u4e92\u3002\n    *   \u8bf4\u660e Opus 5 \u4e0d\u50cf\u65e7\u7248\u6a21\u578b\u90a3\u6837\u6709\u201c\u4fdd\u6301\u201d\u884c\u4e3a\u3002\n\n8.  **monitoring-usage.md:**\n    *   Beta \u8ffd\u8e2a\u7aef\u70b9\uff08`BETA_TRACING_ENDPOINT`\uff09\uff1a\u5982\u679c\u7ba1\u7406\u8bbe\u7f6e\u9501\u5b9a\u4e86\u6536\u96c6\u5668\uff0c\u5f00\u53d1\u8005\u8bbe\u7f6e\u7684\u53d8\u91cf\u73b0\u5728\u4f1a\u88ab\u79fb\u9664\u3002\n    *   `OTEL_LOG_RAW_API_BODIES`\uff1a\u6f84\u6e05\u5b83\u5e94\u8be5\u8bbe\u7f6e\u5728 shell/\u7528\u6237/\u6258\u7ba1\u8bbe\u7f6e\u4e2d\uff08\u5ffd\u7565\u9879\u76ee/\u672c\u5730\u8bbe\u7f6e\uff09\u3002\u5bf9\u5176\u5de5\u4f5c\u65b9\u5f0f\u7684\u8be6\u7ec6\u5206\u89e3\u3002\n\n9.  **plugins-reference.md:** macOS Keychain \u5b58\u50a8\u884c\u4e3a\u7684\u6f84\u6e05\u3002\u5982\u679c Keychain \u62d2\u7edd\u5199\u5165\uff08\u5982\u9501\u5b9a\u7684 Keychain\uff09\uff0c\u5b83\u4f1a\u56de\u9000\u5230\u6587\u4ef6\u5b58\u50a8\u3002\u4e0e `iam.md` \u4e2d\u7684\u66f4\u6539\u76f8\u5339\u914d\u3002\n\n10. **settings.md:**\n    *   `--effort` \u8986\u76d6 `modelSettings` \u548c `effortLevel`\u3002\n    *   `/effort` \u4e3a\u6a21\u578b\u4fdd\u5b58\u7ea7\u522b\u3002\n    *   \u6f84\u6e05 `modelSettings` \u5408\u5e76\u903b\u8f91\uff1a\u9010\u4e2a\u6a21\u578b\u89e3\u6790\u3002\u5b83\u662f\u4e00\u4e2a\u8986\u76d6\u6807\u51c6\u5217\u8868\u5408\u5e76\u7684\u201c\u7279\u6b8a\u201d\u952e\u3002\n\n11. **skills.md / slash-commands.md:**\n    *   \u975e\u4ea4\u4e92\u5f0f\u4f1a\u8bdd\u4e2d\u7684\u547d\u540d\u7a7a\u95f4\u4fee\u590d\u3002\u5982\u679c\u63d2\u4ef6\u524d\u7f00\u5728\u540d\u79f0\u4e2d\uff0c\u5b83\u4e0d\u518d\u91cd\u590d\u6dfb\u52a0\u3002\n\n12. **sub-agents.md:**\n    *   \u5b50\u4ee3\u7406\u6a21\u578b\u9009\u62e9\u903b\u8f91\u66f4\u65b0\u3002\u6f84\u6e05\u4e86\u5c42\u7ea7\uff1a`CLAUDE_CODE_SUBAGENT_MODEL` -> \u4e3b\u5bf9\u8bdd\u6a21\u578b\u3002\n    *   \u901a\u7528\u4ee3\u7406\u8868\u66f4\u65b0\u4ee5\u53cd\u6620\u6b64\u903b\u8f91\u3002\n\n13. **terminal-config.md:**\n    *   \u7c98\u8d34\u884c\u4e3a\u53d8\u66f4\uff1a> 3 \u884c\u800c\u4e0d\u662f > 2 \u884c\u89e6\u53d1\u6298\u53e0\u3002\u8f83\u77ed\u7ec8\u7aef\uff08< 12 \u884c\uff09\u7684\u9608\u503c\u4e5f\u6709\u8c03\u6574\u3002\n\n14. **third-party-integrations.md:**\n    *   \u66f4\u65b0\u4e86\u8868\u5934\uff0c\u6307\u51fa Microsoft Foundry \u652f\u6301\u201c\u65e0\u5bc6\u94a5\u63a7\u5236\u53f0\u767b\u5f55\u201d\u3002\n\n**\u7efc\u5408\uff1a**\n\n*   **\u4e3b\u9898\uff1a**\n    1.  **\u8ba4\u8bc1/\u5b89\u5168\u6027\uff1a** \u5728\u6ca1\u6709 API \u5bc6\u94a5\u7684\u60c5\u51b5\u4e0b\u767b\u5f55\uff08OAuth\uff09\uff0c\u5904\u7406\u9501\u5b9a\u7684 Keychains\uff0c401/403 \u4e0a\u7684\u9759\u9ed8\u91cd\u8bd5\u3002\n    2.  **\u914d\u7f6e/\u8bbe\u7f6e\uff1a** `modelSettings` \u903b\u8f91\uff0c\u52aa\u529b\u7ea7\u522b\u4f18\u5148\u7ea7\uff0c\u6392\u9664\u7b26\u53f7\u94fe\u63a5\u89c4\u5219\uff0c\u53d7\u9650\uff08\u9879\u76ee/\u672c\u5730\uff09\u8bbe\u7f6e\u4e2d\u7684\u9065\u6d4b\u53d8\u91cf\u3002\n    3.  **\u4ee3\u7406/\u94a9\u5b50\uff1a** \u5b50\u4ee3\u7406\u6a21\u578b\u9009\u62e9\uff0c`updatedInput` \u903b\u8f91\u68c0\u67e5\u4fee\u6539\u540e\u7684\u8f93\u5165\uff0c\u63d2\u4ef6\u6280\u80fd\u547d\u540d\u7a7a\u95f4\u3002\n    4.  **UI/UX\uff1a** \u7ec8\u7aef\u4e2d\u7684\u7c98\u8d34\u9608\u503c\u3002\n\n*   **\u5f71\u54cd\u7ea7\u522b\uff1a** **\u4e2d**\u3002\n    *   \u5927\u591a\u6570\u662f\u6f84\u6e05\u6216\u8f7b\u5fae\u884c\u4e3a\u8c03\u6574\uff08\u7ec8\u7aef\u7c98\u8d34\uff0c\u524d\u7f00\u53bb\u91cd\uff09\u3002\n    *   *\u7136\u800c*\uff0c\u4e00\u4e9b\u66f4\u6539\u662f\u529f\u80fd\u6027\u7684\uff1a\n        *   Keychain \u56de\u9000\u662f\u4e00\u4e2a\u91cd\u8981\u7684\u8fb9\u7f18\u60c5\u51b5\u4fee\u590d\u3002\n        *   `updatedInput` \u94a9\u5b50\u903b\u8f91\u53d8\u66f4\u662f\u4e00\u4e2a\u7834\u574f\u6027\u53d8\u66f4\uff0c\u5982\u679c\u6709\u4eba\u4f9d\u8d56\u5bf9\u539f\u59cb\u8f93\u5165\u7684\u68c0\u67e5\u3002\n        *   \u7b26\u53f7\u94fe\u63a5\u6392\u9664\u4fee\u590d\u662f\u4e00\u4e2a\u884c\u4e3a\u53d8\u66f4\u3002\n        *   OAuth \u767b\u5f55\u662f\u4e00\u9879\u65b0\u529f\u80fd\uff0c\u4f46\u901a\u5e38\u5411\u540e\u517c\u5bb9\u3002\n    *   \u7531\u4e8e `updatedInput` \u94a9\u5b50\u903b\u8f91\u548c Keychain \u884c\u4e3a\uff0c\u8fd9\u4e0d\u4ec5\u4ec5\u662f\u6587\u6863\u6e05\u7406\u3002\u6211\u5c06\u8bc4\u4f30\u4e3a\u201c\u4e2d\u201d\u3002\n\n*   **\u884c\u52a8\u9879\uff1a**\n    1.  \u5982\u679c Keychain \u88ab SSH \u4f1a\u8bdd\u9501\u5b9a\uff0c\u8bf7\u68c0\u67e5\u51ed\u8bc1\u5b58\u50a8\u4f4d\u7f6e\u3002\n    2.  \u5982\u679c\u4f7f\u7528\u7b26\u53f7\u94fe\u63a5\uff0c\u8bf7\u5ba1\u67e5 `claudeMdExcludes` \u6a21\u5f0f\u3002\n    3.  \u5982\u679c\u4fee\u6539\u5de5\u5177\u8f93\u5165\uff0c\u8bf7\u66f4\u65b0\u94a9\u5b50\u903b\u8f91\u4ee5\u9884\u671f\u6743\u9650\u68c0\u67e5\u4f1a\u9488\u5bf9*\u4fee\u6539\u540e\u7684*\u8f93\u5165\u8fd0\u884c\u3002\n    4.  \u66f4\u65b0\u811a\u672c/\u8bbe\u7f6e\uff0c\u5c06\u9065\u6d4b\u65e5\u5fd7\u53d8\u91cf\u653e\u5728\u7528\u6237/\u6258\u7ba1\u7ea7\u522b\uff0c\u800c\u975e\u9879\u76ee\u7ea7\u522b\u3002\n    5.  \u68c0\u67e5 `modelSettings` \u4e2d\u7684\u52aa\u529b\u7ea7\u522b\u6301\u4e45\u5316\u903b\u8f91\u3002\n\n**\u8d77\u8349\u4e2d\u6587\u56de\u590d\uff1a**\n\n*   *\u6574\u4f53\u6458\u8981\uff1a* \u6587\u6863\u66f4\u65b0\u4e3b\u8981\u96c6\u4e2d\u5728\u8ba4\u8bc1\u673a\u5236\u7684\u65e0 API Key \u767b\u5f55\u652f\u6301\u3001\u914d\u7f6e\u9879\uff08\u7279\u522b\u662f `modelSettings` \u4e0e `effortLevel`\uff09\u7684\u4f18\u5148\u7ea7\u6f84\u6e05\uff0c\u4ee5\u53ca\u90e8\u5206\u94a9\u5b50\u548c\u7ec8\u7aef\u4ea4\u4e92\u7684\u884c\u4e3a\u5fae\u8c03\u3002\n*   *\u5173\u952e\u4e3b\u9898\uff1a*\n    *   **\u8ba4\u8bc1\u4e0e\u5b89\u5168\uff1a** \u65b0\u589e\u65e0 API Key \u7684\u63a7\u5236\u53f0\u767b\u5f55\uff08\u57fa\u4e8e OAuth\uff09\uff0c\u4fee\u590d\u4e86 macOS Keychain \u4e0d\u53ef\u5199\u65f6\u7684\u964d\u7ea7\u5b58\u50a8\u903b\u8f91\u3002\n    *   **\u914d\u7f6e\u4e0e\u6a21\u578b\uff1a** \u660e\u786e\u4e86 `modelSettings` \u4e0e `effortLevel` \u7684\u5408\u5e76\u4e0e\u8986\u76d6\u903b\u8f91\uff0c\u4ee5\u53ca\u5b50\u4ee3\u7406\u6a21\u578b\u7684\u9009\u62e9\u987a\u5e8f\u3002\n    *   **Hook \u884c\u4e3a\u53d8\u66f4\uff1a** `PreToolUse` hook \u4e2d\u7684 `updatedInput` \u73b0\u5728\u4f1a\u57fa\u4e8e\u4fee\u6539\u540e\u7684\u8f93\u5165\u8fdb\u884c\u6743\u9650\u68c0\u67e5\uff0c\u800c\u975e\u539f\u59cb\u8f93\u5165\u3002\n    *   **\u6392\u9664\u89c4\u5219\u4e0e\u4ea4\u4e92\uff1a** \u4fee\u590d\u4e86\u7b26\u53f7\u94fe\u63a5\u6587\u4ef6\u7684\u6392\u9664\u903b\u8f91\uff0c\u8c03\u6574\u4e86\u7ec8\u7aef\u7c98\u8d34\u5185\u5bb9\u7684\u6298\u53e0\u9608\u503c\u3002\n*   *\u5f71\u54cd\u7ea7\u522b\uff1a* **\u4e2d**\u3002\u867d\u7136\u4e3b\u8981\u662f\u6587\u6863\u6f84\u6e05\uff0c\u4f46 `updatedInput` \u7684\u6743\u9650\u68c0\u67e5\u903b\u8f91\u53d8\u66f4\u548c Keychain \u7684\u5b58\u50a8\u56de\u9000\u673a\u5236\u6d89\u53ca\u5b9e\u9645\u8fd0\u884c\u65f6\u7684\u884c\u4e3a\u53d8\u5316\uff0c\u53ef\u80fd\u5f71\u54cd\u73b0\u6709\u811a\u672c\u7684\u9884\u671f\u7ed3\u679c\u3002\n*   *\u5f00\u53d1\u8005\u884c\u52a8\u9879\uff1a*\n    *   \u68c0\u67e5\u81ea\u5b9a\u4e49 Hooks \u903b\u8f91\uff0c\u7279\u522b\u662f\u4f9d\u8d56\u539f\u59cb\u8f93\u5165\u8fdb\u884c\u6743\u9650\u5224\u65ad\u7684 `PreToolUse` \u94a9\u5b50\uff0c\u9700\u9002\u914d\u4fee\u6539\u540e\u8f93\u5165\u7684\u68c0\u67e5\u673a\u5236\u3002\n    *   \u82e5\u901a\u8fc7 SSH \u8fdc\u7a0b\u4f7f\u7528\u4e14 Keychain \u9501\u5b9a\uff0c\u9700\u4e86\u89e3\u51ed\u8bc1\u4f1a\u56de\u9000\u5b58\u50a8\u5230 `~/.claude/.credentials.json`\u3002\n    *   \u8c03\u6574 `claudeMdExcludes` \u89c4\u5219\u4ee5\u9002\u914d\u7b26\u53f7\u94fe\u63a5\u8def\u5f84\u7684\u5339\u914d\u903b\u8f91\u3002\n    *   \u9065\u6d4b\u914d\u7f6e\uff08\u5982 `OTEL_LOG_RAW_API_BODIES`\uff09\u5e94\u8bbe\u7f6e\u5728\u7528\u6237\u6216\u6258\u7ba1\u8bbe\u7f6e\u5c42\uff0c\u9879\u76ee\u5c42\u8bbe\u7f6e\u5c06\u88ab\u5ffd\u7565\u3002\n    *   \u6ce8\u610f `/effort` \u73b0\u5728\u4f1a\u9488\u5bf9\u7279\u5b9a\u6a21\u578b\u4fdd\u5b58\u8bbe\u7f6e\u5230 `modelSettings` \u4e2d\u3002\n\n\u8ba9\u6211\u4eec\u628a\u5185\u5bb9\u5b8c\u5584\u5f97\u7b80\u6d01\u800c\u6df1\u523b\u3002\n\n\u5bf9\u4e8e `cli-reference.md`\uff0c\u5b83\u589e\u52a0\u4e86 `modelSettings` \u4f5c\u4e3a\u88ab\u8986\u76d6\u7684\u5bf9\u8c61\u3002\n\u5bf9\u4e8e `hooks.md`\uff0c\u53d8\u66f4\u201cClaude Code \u9488\u5bf9\u4f60\u7684 hook \u8fd4\u56de\u7684\u8f93\u5165\u8bc4\u4f30\u6743\u9650\u89c4\u5219\u201d\u662f\u5173\u952e\u70b9\u3002\n\u5bf9\u4e8e `iam.md`\uff0cKeychain \u56de\u9000\u5bf9\u4e8e SSH \u81f3\u5173\u91cd\u8981\u3002\n\u5bf9\u4e8e `terminal-config.md`\uff0c\u7c98\u8d34\u9608\u503c\u662f UX \u8c03\u6574\u3002\n\n\u6700\u7ec8\u6da6\u8272\u3002"}]}