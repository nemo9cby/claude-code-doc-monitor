a\u7684\u89e3\u6790\u5dee\u5f02\u3002\n*   **\u6258\u7ba1\u914d\u7f6e\u4f18\u5148\u7ea7\u8c03\u6574**\uff1a\u7ec4\u7ec7\u901a\u8fc7 `managedMcpServers` \u63d0\u4f9b\u7684 MCP \u670d\u52a1\u5668\u73b0\u5728\u4f18\u5148\u7ea7\u9ad8\u4e8e\u7528\u6237\u914d\u7f6e\u6216\u91cd\u590d\u9879\u3002\n*   **VS Code \u6269\u5c55\u529f\u80fd\u4f18\u5316**\uff1a\u65b0\u589e\u901a\u8fc7 UI \u521b\u5efa\u81ea\u5b9a\u4e49\u8f93\u51fa\u6837\u5f0f\u7684\u529f\u80fd\uff0c\u8fdc\u7a0b\u63a7\u5236\u5f00\u5173\u73b0\u5728\u53ef\u8de8\u7a97\u53e3\u540c\u6b65\uff0c\u5e76\u4fee\u6b63\u4e86\u5173\u4e8e MCP \u914d\u7f6e\u80fd\u529b\u7684\u63cf\u8ff0\uff08\u73b0\u4e3a\u5b8c\u6574\u652f\u6301\uff09\u3002\n\n### \u5f71\u54cd\u7ea7\u522b\uff1a\u4e2d\n\n**\u7406\u7531**\uff1a\u5c3d\u7ba1\u6ca1\u6709\u76f4\u63a5\u7684\u7834\u574f\u6027 API \u53d8\u66f4\uff0c\u4f46\u4ee5\u4e0b\u6539\u52a8\u5bf9\u5f00\u53d1\u8005\u5de5\u4f5c\u6d41\u6709\u663e\u8457\u5f71\u54cd\uff1a\u9ed8\u8ba4\u6a21\u578b\u7248\u672c\u7684\u53d8\u66f4\u53ef\u80fd\u5f71\u54cd\u6027\u80fd\u6216\u6210\u672c\u9884\u671f\uff1b\u63d2\u4ef6\u5728\u65e0\u4ea4\u4e92\u73af\u5883\u4e0b\u7684\u91cd\u8f7d\u884c\u4e3a\u903b\u8f91\u53d1\u751f\u4e86\u6539\u53d8\uff1b\u957f\u65f6\u95f4\u8fd0\u884c\u7684\u540e\u53f0\u4efb\u52a1\u7684\u8d85\u65f6\u673a\u5236\u88ab\u79fb\u9664\u3002\u8fd9\u4e9b\u90fd\u9700\u8981\u5f00\u53d1\u8005\u91cd\u65b0\u9a8c\u8bc1\u73b0\u6709\u914d\u7f6e\u548c\u81ea\u52a8\u5316\u811a\u672c\u3002\n\n### \u5f00\u53d1\u8005\u884c\u52a8\u9879\n\n1.  **\u5347\u7ea7\u7248\u672c**\uff1a\u5efa\u8bae\u5347\u7ea7\u81f3 Claude Code v2.1.261 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u4ee5\u83b7\u5f97 VS Code \u65b0\u529f\u80fd\uff08\u5982\u81ea\u5b9a\u4e49\u8f93\u51fa\u6837\u5f0f\u6784\u5efa\uff09\u53ca\u5b8c\u6574\u7684\u63d2\u4ef6\u91cd\u8f7d\u652f\u6301\u3002\n2.  **\u9a8c\u8bc1\u6a21\u578b\u522b\u540d**\uff1a\u68c0\u67e5\u4f7f\u7528 `fable` \u522b\u540d\u7684\u811a\u672c\u6216\u914d\u7f6e\uff0c\u786e\u8ba4\u5207\u6362\u81f3 Fable 5.1 \u540e\u7684\u884c\u4e3a\u7b26\u5408\u9884\u671f\uff0c\u5e76\u6ce8\u610f\u7f51\u5173\u73af\u5883\u4e0b\u53ef\u80fd\u4ecd\u9700\u6307\u5b9a `claude-fable-5-1`\u3002\n3.  **\u5ba1\u67e5\u63d2\u4ef6\u91cd\u8f7d\u6d41\u7a0b**\uff1a\u5982\u679c\u5728 Agent SDK \u6216\u684c\u9762\u5e94\u7528\u4e2d\u4f9d\u8d56 `/reload-plugins` \u66f4\u65b0 MCP \u670d\u52a1\u5668\u8fde\u63a5\uff0c\u8bf7\u6ce8\u610f\u8be5\u884c\u4e3a\u5df2\u53d8\u66f4\uff0c\u670d\u52a1\u5668\u8fde\u63a5\u72b6\u6001\u5c06\u63a8\u8fdf\u81f3\u4e0b\u4e00\u4f1a\u8bdd\u751f\u6548\u3002\n4.  **\u6d4b\u8bd5\u540e\u53f0\u4efb\u52a1**\uff1a\u786e\u8ba4\u5b50\u4ee3\u7406\u7684\u540e\u53f0\u4efb\u52a1\u4e0d\u518d\u53d7 60 \u5206\u949f\u786c\u6027\u9650\u5236\uff0c\u8fd9\u9002\u7528\u4e8e\u9700\u8981\u957f\u65f6\u95f4\u8fd0\u884c\u7684\u6784\u5efa\u6216\u76d1\u63a7\u4efb\u52a1\u3002\n5.  **\u68c0\u67e5\u6258\u7ba1 MCP \u51b2\u7a81**\uff1a\u5982\u679c\u4f60\u7684\u4e2a\u4eba MCP \u670d\u52a1\u5668\u914d\u7f6e\u4e0e\u7ec4\u7ec7\u901a\u8fc7 `managedMcpServers` \u4e0b\u53d1\u7684\u670d\u52a1\u5668\u91cd\u540d\uff0c\u8bf7\u786e\u8ba4\u7ec4\u7ec7\u670d\u52a1\u5668\u7684\u4f18\u5148\u63a5\u7ba1\u662f\u5426\u7b26\u5408\u9884\u671f\u3002", "reasoning": "\u7528\u6237\u5e0c\u671b\u6211\u5206\u6790 14 \u4e2a\u6587\u6863\u9875\u9762\u7684\u53d8\u66f4\u3002\n\u683c\u5f0f\u9700\u8981\u7b80\u6d01\uff0c\u4f7f\u7528 markdown\uff0c\u5e76\u7528\u4e2d\u6587\u56de\u590d\u3002\n\n**\u4efb\u52a1\uff1a**\n1. \u5206\u6790\u4e00\u6279\u6587\u6863\u53d8\u66f4\u3002\n2. \u63d0\u4f9b\u4e00\u4e2a\u7b80\u8981\u7684\u6458\u8981\u3002\n3. \u786e\u5b9a\u5173\u952e\u4e3b\u9898\u3002\n4. \u8bc4\u4f30\u5f71\u54cd\u7ea7\u522b\uff08\u4f4e/\u4e2d/\u9ad8/\u7834\u574f\u6027\uff09\u5e76\u8bf4\u660e\u7406\u7531\u3002\n5. \u4e3a\u5f00\u53d1\u8005\u63d0\u4f9b\u884c\u52a8\u9879\uff08\u6700\u591a 5 \u70b9\uff09\u3002\n\n**\u53d8\u66f4\u5206\u6790\uff1a**\n\n1.  **cli-reference.md**\uff1a\n    *   `--continue` \u73b0\u5728\u5305\u542b\u5df2\u5b8c\u6210\u7684*\u540e\u53f0\u4f1a\u8bdd*\uff08\u9700\u8981 v2.1.257+\uff09\u3002\n    *   \u4e4b\u524d\uff0c\u5b83\u4f1a\u8df3\u8fc7\u540e\u53f0\u4f1a\u8bdd\u3002\n    *   *\u5f71\u54cd*\uff1aCLI \u5de5\u4f5c\u6d41\u6539\u8fdb\uff0c\u4f7f\u5f97\u6062\u590d\u540e\u53f0\u5de5\u4f5c\u66f4\u52a0\u5bb9\u6613\u3002\n\n2.  **costs.md**\uff1a\n    *   \u91cd\u6784\u4e86\u5173\u4e8e\u8c03\u6574\u6269\u5c55\u601d\u8003\uff08\u601d\u7ef4\u94fe\uff09\u7684\u6587\u672c\u3002\n    *   \u8bd5\u56fe\u5173\u95ed\u601d\u8003\u65f6\u9610\u660e\u4e86\u201cFable \u6a21\u578b\u201d\u7684\u884c\u4e3a\uff08\u65e0\u6cd5\u5173\u95ed\uff09\u3002\n    *   \u7ed3\u6784\u53d8\u52a8\uff1a\u5c06\u5176\u5206\u4e3a\u7b80\u5355\u7684\u4efb\u52a1\u4e0e\u56fa\u5b9a\u7684\u601d\u8003\u9884\u7b97\u3002\n    *   *\u5f71\u54cd*\uff1a\u6f84\u6e05\u4e86\u8ba1\u8d39/\u6a21\u578b\u914d\u7f6e\u3002\n\n3.  **desktop.md**\uff1a\n    *   \u5c06\u201cFable \u6a21\u578b\u201d\u94fe\u63a5\u66f4\u65b0\u4e3a `/docs/en/model-config#work-with-fable`\u3002\n    *   `disableDesktopLocalSessions` \u63cf\u8ff0\u88ab\u622a\u65ad\uff0c\u4f46\u4e0a\u4e0b\u6587\u6697\u793a\u5b83\u662f\u7ba1\u7406\u8bbe\u7f6e\u7684\u63cf\u8ff0\u53d8\u66f4\u3002\n    *   *\u5f71\u54cd*\uff1a\u8f7b\u5fae\u7684\u6587\u6863\u4fee\u6b63/\u94fe\u63a5\u4fee\u590d\u3002\n\n4.  **discover-plugins.md**\uff1a\n    *   `/reload-plugins` \u73b0\u5728\u53ef\u4ee5\u5728\u65e0\u4ea4\u4e92\u7ec8\u7aef\u7684\u4f1a\u8bdd\uff08\u684c\u9762\u5e94\u7528\u3001Agent SDK\u3001\u975e\u4ea4\u4e92\u6a21\u5f0f `-p`\uff09\u4e2d\u8fd0\u884c\uff0c\u4f46\u6709\u4e00\u4e9b\u9650\u5236\uff08\u9700\u8981 v2.1.260+\uff09\u3002\n    *   \u9650\u5236 1\uff1a\u5fc5\u987b\u76f4\u63a5\u5728\u4f1a\u8bdd\u4e2d\u8f93\u5165\uff08\u4e0d\u80fd\u901a\u8fc7\u8fdc\u7a0b\u63a7\u5236/\u4e2d\u7ee7\u6d88\u606f\uff09\u3002\n    *   \u9650\u5236 2\uff1a\u5728\u6b64\u7c7b\u4f1a\u8bdd\u4e2d*\u4e0d*\u8fde\u63a5/\u65ad\u5f00\u63d2\u4ef6 MCP \u670d\u52a1\u5668\u3002\n    *   *\u5f71\u54cd*\uff1a\u63d2\u4ef6\u7cfb\u7edf\u5de5\u4f5c\u6d41\u7684\u91cd\u5927\u53d8\u66f4/\u6f84\u6e05\uff0c\u7279\u522b\u662f\u5728\u96c6\u6210/\u4ee3\u7406\u4e2d\u4f7f\u7528\u63d2\u4ef6\u65f6\u3002\n\n5.  **headless.md**\uff1a\n    *   `--continue` \u53d8\u66f4\uff1a\u5982\u679c\u4f7f\u7528 v2.1.257+\uff0c\u73b0\u5728\u4f1a\u6253\u5f00*\u5df2\u5b8c\u6210\u7684\u540e\u53f0\u4f1a\u8bdd*\u3002\n    *   `--resume`\uff1a\u73b0\u5728\u53ef\u4ee5\u901a\u8fc7\u7edd\u5bf9\u8def\u5f84\u63a5\u53d7 `.jsonl` \u8f6c\u5f55\u6587\u4ef6\u8def\u5f84\u3002\n    *   *\u5f71\u54cd*\uff1aCLI \u6062\u590d\u5de5\u4f5c\u6d41\u7684\u6539\u8fdb\u3002\n\n6.  **interactive-mode.md**\uff1a\n    *   \u540e\u53f0\u4efb\u52a1\uff1a\u5220\u9664\u4e86 `subagent`\uff08\u5b50\u4ee3\u7406\uff09\u62e5\u6709\u7684\u540e\u53f0\u547d\u4ee4\u7684 60 \u5206\u949f\u9650\u5236\u3002\u73b0\u5728\u5b83\u4eec\u6ca1\u6709\u65f6\u95f4\u9650\u5236\uff08\u9664\u975e\u524d\u53f0\u5b50\u4ee3\u7406\u7ed3\u675f\uff09\u3002\n    *   \u4fa7\u95ee\u9898 `/btw`\uff1a\u66f4\u65b0\u4e86\u5bfc\u822a\u952e\u63cf\u8ff0\u3002\u5220\u9664\u4e86\u5173\u4e8e\u6309 `Left` \u7684\u7279\u5b9a\u7248\u672c\u6ce8\u91ca\uff08\u6697\u793a\u4e3a\u6807\u51c6\u884c\u4e3a\uff09\u3002\n    *   *\u5f71\u54cd*\uff1a\u957f\u65f6\u95f4\u8fd0\u884c\u7684\u540e\u53f0\u4efb\u52a1\u7684\u6027\u80fd/\u53ef\u7528\u6027\u6539\u8fdb\u3002\n\n7.  **mcp.md**\uff1a\n    *   `disabledMcpServers` \u73b0\u5728\u5305\u542b\u201c\u7ec4\u7ec7\u901a\u8fc7\u6258\u7ba1\u8bbe\u7f6e\u63d0\u4f9b\u7684\u201d\u670d\u52a1\u5668\u3002\n    *   `/reload-plugins` \u975e\u4ea4\u4e92\u5f0f\u4f1a\u8bdd\u9650\u5236\uff1a\u5728 MCP \u751f\u547d\u5468\u671f\u4e2d\u63d0\u53ca\u4e86\u4e0e `discover-plugins.md` \u76f8\u540c\u7684\u9650\u5236\u3002\n    *   \u4f18\u5148\u7ea7\uff1a\u6765\u81ea `managedMcpServers` \u7684\u6258\u7ba1\u670d\u52a1\u5668\u6392\u540d\u9ad8\u4e8e\u91cd\u590d\u9879\uff08v2.1.259+\uff09\u3002\n    *   \u8fde\u63a5\u5668\u52a0\u8f7d\u5931\u8d25\uff1a\u4e34\u65f6\u7f51\u7edc\u9519\u8bef\u7684\u91cd\u8bd5\u903b\u8f91\uff08\u6700\u591a 3 \u6b21\uff09\u3002\n    *   \u6258\u7ba1 MCP \u914d\u7f6e\u7ae0\u8282\u63d0\u53ca `managedMcpServers`\u3002\n    *   *\u5f71\u54cd*\uff1a\u6258\u7ba1\u914d\u7f6e/MCP \u903b\u8f91\u7684\u91cd\u5927\u66f4\u65b0\u3002\n\n8.  **model-config.md**\uff1a\n    *   Fable \u522b\u540d\u89e3\u6790\uff1aFable 5.1 \u73b0\u5728\u662f `fable` \u522b\u540d\u7684\u9ed8\u8ba4\u503c\uff08\u4e4b\u524d\u662f Fable 5\uff09\u3002\n    *   Claude \u5e94\u7528\u7f51\u5173\u4e0a\u7684\u4f8b\u5916\uff1a`fable` \u5728\u90a3\u91cc\u89e3\u6790\u4e3a Fable 5\uff08\u9664\u975e\u914d\u7f6e\u4e86 5.1\uff09\u3002\n    *   \u9700\u8981\u7279\u5b9a\u7248\u672c\uff1aFable 5.1 \u9700\u8981 v2.1.257+\uff08\u4e4b\u524d\u662f v2.1.255\uff09\u3002\n    *   *\u5f71\u54cd*\uff1a\u6a21\u578b\u9ed8\u8ba4\u503c\u7684\u53d8\u66f4\uff0c\u53ef\u80fd\u5f71\u54cd\u73b0\u6709\u5de5\u4f5c\u6d41\uff0c\u5982\u679c\u5b83\u4eec\u4f9d\u8d56\u4e8e\u786e\u5207\u7684\u6a21\u578b\u884c\u4e3a\uff08\u4f8b\u5982\uff0c\u7f51\u5173\u7528\u6237\u7684\u7834\u574f\u6027\uff1f\uff09\u3002\n\n9.  **output-styles.md**\uff1a\n    *   VS Code \u6269\u5c55\u53ef\u4ee5\u521b\u5efa\u81ea\u5b9a\u4e49\u8f93\u51fa\u6837\u5f0f\u6587\u4ef6\uff08v2.1.261+\uff09\u3002\n    *   *\u5f71\u54cd*\uff1aVS Code \u7684\u7528\u6237\u4f53\u9a8c\u6539\u8fdb\u3002\n\n10. **plugins.md**\uff1a\n    *   `/reload-plugins` \u975e\u4ea4\u4e92\u5f0f\u4f1a\u8bdd\u9650\u5236\u94fe\u63a5\u56de `discover-plugins.md`\u3002\n    *   *\u5f71\u54cd*\uff1a\u4e0e\u5176\u4ed6\u53d8\u66f4\u4fdd\u6301\u4e00\u81f4\u3002\n\n11. **plugins-reference.md**\uff1a\n    *   \u63d2\u4ef6\u66f4\u65b0\u884c\u4e3a\uff1a\u5728\u975e\u4ea4\u4e92\u5f0f\u4f1a\u8bdd\u4e2d\uff0c\u63d2\u4ef6 MCP \u670d\u52a1\u5668\u5728\u91cd\u8f7d\u671f\u95f4\u505c\u7559\u5728\u65e7\u8def\u5f84\u4e0a\u76f4\u5230\u4e0b\u4e00\u4e2a\u4f1a\u8bdd\u3002\n    *   *\u5f71\u54cd*\uff1a\u63d2\u4ef6\u5f00\u53d1\u6ce8\u610f\u4e8b\u9879\u3002\n\n12. **settings.md**\uff1a\n    *   \u6587\u672c\u63aa\u8f9e\u8c03\u6574\u4ee5\u9610\u660e `/model` \u548c `/effort` \u7684\u6301\u4e45\u5316\u3002\n    *   *\u5f71\u54cd*\uff1a\u6587\u6863\u6e05\u6670\u5ea6\u3002\n\n13. **sub-agents.md**\uff1a\n    *   \u5df2\u5b8c\u6210\u7684\u5b50\u4ee3\u7406\u5728 `/tasks` \u4e2d\u4fdd\u7559 30 \u79d2\uff08\u9610\u660e\u4e86\u65f6\u95f4\u7a97\u53e3\uff09\u3002\n    *   \u6062\u590d\u5b50\u4ee3\u7406\uff1a\u9610\u660e\u5b83\u4eec\u4f1a\u4fdd\u7559\u5d4c\u5957\u5b50\u4ee3\u7406\u7684\u5386\u53f2\u8bb0\u5f55\u3002\n    *   `SendMessage` \u884c\u4e3a\uff1a\u9610\u660e\u5d4c\u5957\u5b50\u4ee3\u7406\u5982\u4f55\u5904\u7406\u6d88\u606f\u3002\n    *   *\u5f71\u54cd*\uff1a\u5b50\u4ee3\u7406\u884c\u4e3a\u7ec6\u8282\u3002\n\n14. **vs-code.md**\uff1a\n    *   \u6a21\u578b\u9009\u62e9\u5668\u66f4\u6539\uff1a\u6f84\u6e05\u4e86 `Effort`\uff08\u7cbe\u529b\uff09\u884c\u7684\u53ef\u7528\u6027\u3002\n    *   \u8f93\u51fa\u6837\u5f0f\uff1a\u201c\u6784\u5efa\u81ea\u5b9a\u4e49\u6837\u5f0f\u201d\u83dc\u5355\u9879\uff08v2.1.261+\uff09\u3002\n    *   \u8fdc\u7a0b\u63a7\u5236\u5207\u6362\uff1a\u5f71\u54cd\u6240\u6709 VS Code \u7a97\u53e3\uff08v2.1.261+\uff09\uff0c\u4e0d\u4ec5\u4ec5\u662f\u5f53\u524d\u7a97\u53e3\u3002\n    *   MCP \u914d\u7f6e\uff1a\u66f4\u65b0\u4e86\u5bf9\u6bd4\u8868\uff0c\u663e\u793a VS Code *\u53ef\u4ee5*\u914d\u7f6e MCP \u670d\u52a1\u5668\uff08\u4e0d\u53ea\u662f\u201c\u90e8\u5206\u201d\uff09\u3002\n    *   *\u5f71\u54cd*\uff1aVS Code \u7528\u6237\u4f53\u9a8c\u589e\u5f3a\u3002\n\n**\u7efc\u5408\uff1a**\n\n*   **\u4e3b\u9898**\uff1a\n    1.  **\u7248\u672c\u9608\u503c (v2.1.257, v2.1.259, v2.1.260, v2.1.261)**\uff1a\u8bb8\u591a\u53d8\u66f4\u5f15\u7528\u4e86\u65b0\u7684\u7279\u5b9a\u7248\u672c\u3002\u8fd9\u8868\u660e\u91cd\u5927\u66f4\u65b0\u3002\n    2.  **\u540e\u53f0/\u975e\u4ea4\u4e92\u5f0f\u4f1a\u8bdd\u884c\u4e3a**\uff1a\u5173\u4e8e `/reload-plugins`\u3001`--continue` \u548c MCP \u670d\u52a1\u5668\u751f\u547d\u5468\u671f\u7684\u91cd\u8981\u53d8\u66f4\u3002\n    3.  **\u6258\u7ba1/\u7ec4\u7ec7\u914d\u7f6e**\uff1a`managedMcpServers` \u4f18\u5148\u7ea7\u3001\u684c\u9762\u8bbe\u7f6e\u3002\n    4.  **\u6a21\u578b\u53d8\u66f4**\uff1aFable 5.1 \u4f5c\u4e3a\u65b0\u7684 `fable` \u522b\u540d\u9ed8\u8ba4\u503c\u3002\n    5.  **VS Code \u6269\u5c55\u529f\u80fd**\uff1a\u66f4\u597d\u7684 UI \u7528\u4e8e\u81ea\u5b9a\u4e49\u6837\u5f0f\u548c MCP \u914d\u7f6e\u3002\n\n*   **\u5f71\u54cd\u7ea7\u522b**\uff1a**\u4e2d**\u3002\n    *   *\u7406\u7531*\uff1a\u867d\u7136\u6ca1\u6709\u76f4\u63a5\u7684\u201c\u7834\u574f\u6027\u201d\u53d8\u66f4\uff08\u6bd4\u5982\u5220\u9664\u6807\u5fd7\uff09\uff0c\u4f46\u9ed8\u8ba4\u884c\u4e3a\uff08Fable \u522b\u540d\uff09\u3001\u63d2\u4ef6\u5728\u540e\u53f0\u4f1a\u8bdd\u4e2d\u7684\u91cd\u8f7d\u884c\u4e3a\u4ee5\u53ca\u540e\u53f0\u4efb\u52a1\u65f6\u95f4\u9650\u5236\u90fd\u53d1\u751f\u4e86\u663e\u8457\u53d8\u5316\u3002\u5bf9\u4e8e\u81ea\u5b9a\u4e49\u63d2\u4ef6\u6216\u4f7f\u7528\u4ee3\u7406\u7684\u5f00\u53d1\u8005\u6765\u8bf4\uff0c\u8fd9\u4e9b\u662f\u91cd\u8981\u66f4\u65b0\u3002\n\n*   **\u884c\u52a8\u9879**\uff1a\n    1.  **\u5347\u7ea7**\uff1a\u5347\u7ea7\u5230 v2.1.261+ \u4ee5\u83b7\u5f97\u5b8c\u6574\u7684 VS Code \u548c\u91cd\u8f7d\u529f\u80fd\u3002\n    2.  **\u68c0\u67e5\u9ed8\u8ba4\u6a21\u578b**\uff1a\u9a8c\u8bc1 `fable` \u89e3\u6790\u4e3a Fable 5.1 \u662f\u5426\u5bf9\u5de5\u4f5c\u6d41/\u7f51\u5173\u517c\u5bb9\u6027\u6709\u5f71\u54cd\u3002\n    3.  **\u5ba1\u67e5\u63d2\u4ef6\u91cd\u8f7d**\uff1a\u5982\u679c\u5728 Agent SDK \u6216\u684c\u9762\u5e94\u7528\u4e2d\u4f7f\u7528\u63d2\u4ef6\uff0c\u8981\u6ce8\u610f `/reload-plugins` \u7684\u9650\u5236\uff08\u65e0\u6cd5\u5728\u91cd\u8f7d\u671f\u95f4\u7acb\u5373\u91cd\u65b0\u8fde\u63a5 MCP\uff09\u3002\n    4.  **\u6d4b\u8bd5\u540e\u53f0\u4efb\u52a1**\uff1a\u9a8c\u8bc1\u5b50\u4ee3\u7406\u540e\u53f0\u4efb\u52a1\u7684\u79fb\u9664\u65f6\u95f4\u9650\u5236\u662f\u5426\u7b26\u5408\u9884\u671f\uff08\u5b83\u4eec\u73b0\u5728\u8fd0\u884c\u65f6\u95f4\u66f4\u957f\uff09\u3002\n    5.  **\u5ba1\u67e5\u6258\u7ba1 MCP**\uff1a\u5982\u679c\u4f7f\u7528\u7ec4\u7ec7\u7ea7 MCP \u670d\u52a1\u5668\uff0c\u68c0\u67e5\u65b0\u7684\u4f18\u5148\u7ea7\u89c4\u5219\u3002\n\n**\u8d77\u8349\u56de\u590d\uff08\u5185\u5fc3\u72ec\u767d/\u5c1d\u8bd5\uff09\uff1a**\n*   *\u6458\u8981*\uff1a\u6587\u6863\u66f4\u65b0\u4fa7\u91cd\u4e8e\u6539\u8fdb\u540e\u53f0/\u975e\u4ea4\u4e92\u5f0f\u4f1a\u8bdd\u7684\u5904\u7406\uff0c\u66f4\u65b0 VS Code \u6269\u5c55\u529f\u80fd\uff0c\u5e76\u5c06\u9ed8\u8ba4 Fable \u6a21\u578b\u5207\u6362\u5230 5.1\u3002\n*   *\u4e3b\u9898*\uff1a\u540e\u53f0/\u975e\u4ea4\u4e92\u5f0f\u4f1a\u8bdd\u7684\u903b\u8f91\u53d8\u66f4\uff0c\u6a21\u578b\u522b\u540d\u66f4\u65b0\uff0c\u6258\u7ba1\u914d\u7f6e\u589e\u5f3a\uff0cVS Code UX \u6539\u8fdb\u3002\n*   *\u5f71\u54cd*\uff1a\u4e2d\u3002\u9ed8\u8ba4\u503c\u6539\u53d8\u4e86\uff08Fable\uff09\uff0c\u63d2\u4ef6\u91cd\u8f7d\u903b\u8f91\u53d8\u4e86\uff0c\u540e\u53f0\u4efb\u52a1\u65f6\u95f4\u9650\u5236\u53d8\u4e86\u3002\n*   *\u884c\u52a8\u9879*\uff1a\u5347\u7ea7\u7248\u672c\uff0c\u68c0\u67e5 Fable \u6a21\u578b\u89e3\u6790\uff0c\u5ba1\u67e5\u63d2\u4ef6\u91cd\u8f7d\u884c\u4e3a\u3002\n\n**\u8bed\u8a00\u6da6\u8272\uff08\u4e2d\u6587\uff09\uff1a**\n*   Overall Summary: \u672c\u6b21\u6587\u6863\u66f4\u65b0\u4e3b\u8981\u96c6\u4e2d\u5728\u6539\u8fdb\u540e\u53f0\u548c\u975e\u4ea4\u4e92\u5f0f\u4f1a\u8bdd\u7684\u884c\u4e3a\uff08\u5982\u63d2\u4ef6\u91cd\u8f7d\u3001\u5b50\u4ee3\u7406\u540e\u53f0\u4efb\u52a1\uff09\u3001\u63d0\u5347 VS Code \u6269\u5c55\u7684\u7528\u6237\u4f53\u9a8c\uff0c\u4ee5\u53ca\u5c06\u9ed8\u8ba4\u7684 `fable` \u6a21\u578b\u522b\u540d\u66f4\u65b0\u81f3 Fable 5.1\u3002\n*   Key Themes:\n    *   **\u540e\u53f0\u4e0e\u975e\u4ea4\u4e92\u5f0f\u4f1a\u8bdd\u589e\u5f3a**: `--continue` \u73b0\u5728\u652f\u6301\u6062\u590d\u5df2\u7ed3\u675f\u7684\u540e\u53f0\u4f1a\u8bdd\uff1b`/reload-plugins` \u5728\u65e0\u7ec8\u7aef\u4f1a\u8bdd\u4e2d\u53ef\u7528\u4f46\u6709 MCP \u670d\u52a1\u5668\u8fde\u63a5\u9650\u5236\uff1b\u79fb\u9664\u4e86\u5b50\u4ee3\u7406\u540e\u53f0\u4efb\u52a1\u7684 60 \u5206\u949f\u8d85\u65f6\u9650\u5236\u3002\n    *   **\u6a21\u578b\u914d\u7f6e\u53d8\u66f4**: `fable` \u522b\u540d\u73b0\u5728\u9ed8\u8ba4\u89e3\u6790\u4e3a Fable 5.1\uff08\u800c\u975e Fable 5\uff09\uff0c\u5e76\u66f4\u65b0\u4e86\u76f8\u5173\u7248\u672c\u8981\u6c42\u3002\n    *   **\u6258\u7ba1\u914d\u7f6e\u4f18\u5148\u7ea7**: \u7ec4\u7ec7\u901a\u8fc7 `managedMcpServers` \u63d0\u4f9b\u7684 MCP \u670d\u52a1\u5668\u73b0\u5728\u5177\u6709\u66f4\u9ad8\u7684\u4f18\u5148\u7ea7\u3002\n    *   **VS Code \u6269\u5c55\u529f\u80fd**: \u589e\u52a0\u4e86\u901a\u8fc7 UI \u521b\u5efa\u81ea\u5b9a\u4e49\u8f93\u51fa\u6837\u5f0f\u3001\u8de8\u7a97\u53e3\u540c\u6b65\u8fdc\u7a0b\u63a7\u5236\u8bbe\u7f6e\u4ee5\u53ca\u5b8c\u5168\u7684 MCP \u670d\u52a1\u5668\u914d\u7f6e\u80fd\u529b\u3002\n*   Impact Level: **\u4e2d (Medium)**. \u7406\u7531\uff1a\u867d\u7136\u5927\u90e8\u5206\u662f\u975e\u7834\u574f\u6027\u66f4\u65b0\uff0c\u4f46\u6a21\u578b\u522b\u540d\u7684\u9ed8\u8ba4\u503c\u53d8\u66f4\uff08Fable 5 -> 5.1\uff09\u3001\u63d2\u4ef6\u91cd\u8f7d\u903b\u8f91\u7684\u53d8\u5316\u4ee5\u53ca\u5b50\u4ee3\u7406\u540e\u53f0\u4efb\u52a1\u8d85\u65f6\u9650\u5236\u7684\u79fb\u9664\uff0c\u90fd\u4f1a\u76f4\u63a5\u5f71\u54cd\u73b0\u6709\u7684\u5f00\u53d1\u548c\u90e8\u7f72\u5de5\u4f5c\u6d41\u3002\n*   Action items:\n    *   **\u5347\u7ea7\u7248\u672c**: \u5efa\u8bae\u5347\u7ea7\u81f3 Claude Code v2.1.261 \u6216\u66f4\u9ad8\u7248\u672c\uff0c\u4ee5\u83b7\u5f97 VS Code \u65b0\u529f\u80fd\u548c\u5b8c\u6574\u7684\u63d2\u4ef6\u91cd\u8f7d\u652f\u6301\u3002\n    *   **\u68c0\u67e5\u6a21\u578b\u884c\u4e3a**: \u9a8c\u8bc1\u4f7f\u7528 `fable` \u522b\u540d\u6216 Fable 5 \u7684\u811a\u672c\u548c\u914d\u7f6e\u662f\u5426\u4e0e\u65b0\u7684\u9ed8\u8ba4\u503c\uff08Fable 5.1\uff09\u53ca\u7f51\u5173\u517c\u5bb9\u6027\u8981\u6c42\u517c\u5bb9\u3002\n    *   **\u5ba1\u67e5\u63d2\u4ef6\u91cd\u8f7d\u903b\u8f91**: \u5982\u679c\u5728 Agent SDK \u6216\u684c\u9762\u5e94\u7528\u4e2d\u4f7f\u7528\u63d2\u4ef6\uff0c\u8bf7\u6ce8\u610f `/reload-plugins` \u73b0\u5728\u4e0d\u4f1a\u7acb\u5373\u91cd\u8fde MCP \u670d\u52a1\u5668\uff0c\u9700\u5728\u4e0b\u4e00\u4f1a\u8bdd\u751f\u6548\u3002\n    *   **\u6d4b\u8bd5\u540e\u53f0\u4efb\u52a1**: \u786e\u8ba4\u5b50\u4ee3\u7406\u540e\u53f0\u4efb\u52a1\u7684\u957f\u65f6\u95f4\u8fd0\u884c\u4e0d\u518d\u53d7 60 \u5206\u949f\u9650\u5236\uff0c\u7b26\u5408\u9884\u671f\u3002\n    *   **\u914d\u7f6e\u6258\u7ba1 MCP**: \u68c0\u67e5\u7ec4\u7ec7\u5185\u7684 MCP \u670d\u52a1\u5668\u8bbe\u7f6e\uff0c\u786e\u4fdd\u4e86\u89e3\u65b0\u7684\u4f18\u5148\u7ea7\u89c4\u5219\uff08`managedMcpServers` \u4f18\u5148\u4e8e\u7528\u6237\u914d\u7f6e\uff09\u3002\n\n\u770b\u8d77\u6765\u5f88\u7a33\u59a5\u3002\u7ee7\u7eed\u751f\u6210 markdown\u3002"}]}