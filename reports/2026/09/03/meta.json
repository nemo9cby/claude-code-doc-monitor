b\u662f\u4e0d\u518d\u660e\u786e\u6392\u9664\u72b6\u6001\u7ba1\u7406\u76f8\u5173\u7684 Threads \u53c2\u6570\u548c\u8def\u7531\u4f18\u5316\u53c2\u6570\u3002\n*   **Threads \u652f\u6301\u589e\u5f3a**\uff1a\u79fb\u9664\u4e86\u201cThreads are stateful; batch requests are not\u201d\u7684\u8bf4\u660e\uff0c\u8868\u660e\u6279\u5904\u7406\u8bf7\u6c42\u73b0\u5728\u53ef\u80fd\u80fd\u591f\u5904\u7406\u6216\u5229\u7528 Threads \u7684\u4e0a\u4e0b\u6587\u72b6\u6001\u3002\n*   **\u8def\u7531\u4e0e\u8c03\u5ea6\u4f18\u5316**\uff1a\u79fb\u9664 `cache_hint` \u548c `context_hint` \u7684\u9650\u5236\u610f\u5473\u7740\u5f00\u53d1\u8005\u73b0\u5728\u53ef\u4ee5\u5728\u6279\u5904\u7406\u4efb\u52a1\u4e2d\u4f7f\u7528\u8fd9\u4e9b\u63d0\u793a\u6765\u5f71\u54cd\u8bf7\u6c42\u8c03\u5ea6\u548c\u7f13\u5b58\u884c\u4e3a\u3002\n\n### 3. \u5f71\u54cd\u7ea7\u522b\n**Medium (\u4e2d\u7b49)**\n\u867d\u7136\u8fd9\u4e0d\u662f\u7834\u574f\u6027\u53d8\u66f4\uff0c\u4f46\u8fd9\u662f\u4e00\u4e2a\u91cd\u8981\u7684\u529f\u80fd\u589e\u5f3a\u3002\u5b83\u89e3\u9501\u4e86\u6279\u5904\u7406 API \u4e0e\u5176\u4ed6\u9ad8\u7ea7\u529f\u80fd\uff08\u5982 Threads \u548c\u81ea\u52a8\u8bc4\u4f30 `store`\uff09\u7684\u534f\u540c\u5de5\u4f5c\u80fd\u529b\uff0c\u5141\u8bb8\u5f00\u53d1\u8005\u6784\u5efa\u66f4\u590d\u6742\u3001\u6709\u72b6\u6001\u7684\u5f02\u6b65 AI \u5de5\u4f5c\u6d41\u3002\n\n### 4. \u5f00\u53d1\u8005\u884c\u52a8\u4e8b\u9879\n*   **\u5c1d\u8bd5 Threads \u96c6\u6210**\uff1a\u68c0\u67e5 Message Batches API \u662f\u5426\u73b0\u5728\u652f\u6301 `previous_thread_event_id`\uff0c\u4ee5\u4fbf\u5728\u6279\u5904\u7406\u4e2d\u7ef4\u6301\u5bf9\u8bdd\u4e0a\u4e0b\u6587\u3002\n*   **\u5229\u7528 `store` \u53c2\u6570**\uff1a\u5c1d\u8bd5\u5728\u6279\u5904\u7406\u8bf7\u6c42\u4e2d\u542f\u7528 `store`\uff0c\u4ee5\u5229\u7528\u81ea\u52a8\u8bc4\u4f30\u548c\u6570\u636e\u5b58\u50a8\u529f\u80fd\u3002\n*   **\u4f18\u5316\u8def\u7531**\uff1a\u5728\u6279\u5904\u7406\u8bf7\u6c42\u4e2d\u6dfb\u52a0 `cache_hint` \u6216 `context_hint`\uff0c\u4ee5\u6d4b\u8bd5\u662f\u5426\u80fd\u6539\u5584\u7f13\u5b58\u547d\u4e2d\u7387\u6216\u8bf7\u6c42\u8def\u7531\u3002\n*   **\u542f\u7528\u7814\u7a76\u9884\u89c8**\uff1a\u5982\u679c\u9879\u76ee\u9700\u8981\uff0c\u53ef\u4ee5\u5728\u6279\u5904\u7406 API \u4e2d\u6d4b\u8bd5 `research_preview_2026_02` \u529f\u80fd\u3002", "reasoning": "1. **\u7406\u89e3\u76ee\u6807**\uff1a\u7528\u6237\u5e0c\u671b\u4ee5\u4e00\u540d\u4e16\u754c\u7ea7\u7a0b\u5e8f\u5458\u7684\u8eab\u4efd\uff0c\u7528\u4e2d\u6587\u5206\u6790\u6587\u6863\u7684\u53d8\u66f4\u3002\u6211\u9700\u8981\u603b\u7ed3*\u53d1\u751f\u4e86\u4ec0\u4e48\u53d8\u5316*\u4ee5\u53ca*\u4e3a\u4f55\u8fd9\u5bf9\u5f00\u53d1\u8005\u91cd\u8981*\u3002\u5206\u6790\u9700\u4ee5 Markdown \u683c\u5f0f\u5448\u73b0\uff0c\u5305\u542b\u56db\u4e2a\u7279\u5b9a\u90e8\u5206\uff1a\u603b\u4f53\u6458\u8981\u3001\u5173\u952e\u4e3b\u9898\u3001\u5f71\u54cd\u7ea7\u522b\u548c\u884c\u52a8\u4e8b\u9879\u3002\u80cc\u666f\u662f\u5bf9 `build-with-claude/batch-processing.md` \u6587\u6863\u7684\u4e00\u6b21\u5355\u72ec\u53d8\u66f4\u3002\n\n2. **\u5206\u6790\u53d8\u66f4**\uff1a\n    *   **\u6587\u4ef6**\uff1a`build-with-claude/batch-processing.md`\n    *   **\u53d8\u66f4**\uff1a\n        *   \u4ece\u63cf\u8ff0\u201c\u54ea\u4e9b\u53ef\u4ee5\u88ab\u6279\u5904\u7406\u201d\u7684\u8868\u683c\u4e2d\u79fb\u9664\u4e86\u51e0\u884c\u3002\n        *   \u79fb\u9664\u7684\u5185\u5bb9\uff1a\n            *   `store` / `previous_thread_event_id`\uff08Threads\uff09\uff1a\u79fb\u9664\u539f\u56e0\uff1f\u4e5f\u8bb8\u8fd9\u4e9b\u529f\u80fd\u73b0\u5728*\u652f\u6301*\u6279\u5904\u7406\uff0c\u6216\u8005\u4e0d\u518d\u76f8\u5173/\u88ab\u5e9f\u5f03\u4e86\u3002\u770b diff\uff0c\u539f\u6587\u79f0\u5b83\u4eec\u201c\u4e0d\u88ab\u652f\u6301\u201d\u3002\u73b0\u5728\u5b83\u4eec\u4ece\u201c\u4e0d\u652f\u6301\u201d\u5217\u8868\u4e2d\u6d88\u5931\u4e86\u3002\u8fd9\u6697\u793a\u4e86\u5b83\u4eec\u73b0\u5728\u53ef\u80fd*\u88ab\u652f\u6301*\uff0c\u6216\u8005\u5217\u8868\u4ec5\u5173\u6ce8\u5269\u4f59\u7684\u5173\u952e\u4e0d\u517c\u5bb9\u9879\u3002\n            *   `cache_hint` / `context_hint`\uff1a\u79fb\u9664\u539f\u56e0\uff1f\u540c\u6837\uff0c\u539f\u6587\u79f0\u5b83\u4eec\u9002\u7528\u4e8e\u540c\u6b65\u8bf7\u6c42\u8c03\u5ea6\u3002\u73b0\u5728\u5b83\u4eec\u6d88\u5931\u4e86\u3002\n            *   `research_preview_2026_02: \"active\"`\uff1a\u79fb\u9664\u539f\u56e0\uff1f\u539f\u6587\u79f0\u5176\u5728\u6279\u5904\u7406\u8def\u5f84\u4e0a\u4e0d\u53ef\u7528\u3002\u73b0\u5728\u6d88\u5931\u4e86\u3002\n        *   \u4fee\u6539\u4e86 FAQ \u90e8\u5206\uff1a\u201c\u6211\u53ef\u4ee5\u5c06 Message Batches API \u4e0e\u5176\u4ed6 API \u529f\u80fd\u4e00\u8d77\u4f7f\u7528\u5417\uff1f\u201d\n            *   \u66f4\u65b0\u4e86\u4e0d\u88ab\u652f\u6301\u7684\u53c2\u6570\u5217\u8868\u3002\u5b83\u4ece\u660e\u786e\u5217\u51fa\u7684\u4e0d\u517c\u5bb9\u53c2\u6570\u4e2d\u79fb\u9664\u4e86 `store`\u3001`previous_thread_event_id`\u3001`cache_hint`\u3001`context_hint` \u548c `research_preview_2026_02`\u3002\n            *   \u5269\u4f59\u7684\u4e0d\u517c\u5bb9\u9879\uff1a`stream`\u3001`speed`\u3001`max_tokens: 0`\u3002\n\n3. **\u89e3\u8bfb\u201c\u539f\u56e0\u201d\uff08\u5f00\u53d1\u8005\u7684\u610f\u4e49\uff09**\uff1a\n    *   \u6587\u6863\u4e4b\u524d\u5217\u51fa\u4e86\u591a\u4e2a\u4e0d\u517c\u5bb9\u7684\u53c2\u6570\u3002\n    *   \u73b0\u5728\u5b83\u5220\u9664\u4e86\u5176\u4e2d\u7684\u8bb8\u591a\uff0c\u4ec5\u7559\u4e0b\u4e86\u6838\u5fc3\u7684\u4e0d\u517c\u5bb9\u9879\uff08`stream`\u3001`speed`\u3001`max_tokens: 0`\uff09\u3002\n    *   *\u5173\u952e\u63a8\u65ad*\uff1a\u5982\u679c\u67d0\u9879\u4ece\u201c\u4e0d\u88ab\u652f\u6301\u201d\u5217\u8868\u4e2d\u79fb\u9664\uff0c\u901a\u5e38\u610f\u5473\u7740\u5b83**\u73b0\u5728\u88ab\u652f\u6301\u4e86**\u3002\n    *   \u56e0\u6b64\uff0cClaude \u7684 Message Batches API \u73b0\u5728\u53ef\u80fd\u652f\u6301\uff1a\n        *   Threads\uff08\u72b6\u6001\u7ba1\u7406\uff09\u3002\n        *   \u8def\u7531\u63d0\u793a\uff08`cache_hint`\u3001`context_hint`\uff09\u3002\n        *   \u7814\u7a76\u9884\u89c8\u529f\u80fd\u3002\n    *   \u6216\u8005\uff0c\u6587\u6863\u5f97\u5230\u4e86\u7b80\u5316\uff0c\u56e0\u4e3a\uff08Threads \u7b49\u7684\uff09\u67b6\u6784\u5df2\u7ecf\u6210\u719f\uff0c\u8fd9\u4e9b\u529f\u80fd\u662f\u53ef\u7528\u7684\uff0c\u6216\u8005\u660e\u786e\u6307\u51fa\u5b83\u4eec\u53d7\u9650\u662f\u4e0d\u518d\u5fc5\u8981\u7684\uff0c\u4f46\u901a\u5e38\u5728 API \u6587\u6863\u4e2d\uff0c\u5c06\u67d0\u9879\u4ece\u201c\u9650\u5236\u201d\u5217\u8868\u4e2d\u79fb\u9664\u662f\u529f\u80fd\u5f00\u542f\u7684\u4fe1\u53f7\u3002\n    *   *\u5bf9\u201cstore\u201d\u7684\u4f18\u5316*\uff1a`store` \u901a\u5e38\u4e0e\u81ea\u52a8\u8bc4\u4f30\u6216\u7f13\u5b58\u6709\u5173\u3002\u5982\u679c\u5df2\u79fb\u9664\uff0c\u4e5f\u8bb8\u6279\u5904\u7406\u73b0\u5728\u652f\u6301\u81ea\u52a8\u5b58\u50a8/\u8bc4\u4f30\u3002\n    *   *\u5bf9\u201cThreads\u201d\u7684\u4f18\u5316*\uff1a\u6279\u5904\u7406\u662f\u65e0\u72b6\u6001\u7684\uff08\u5355\u6761\u6d88\u606f\uff09\u3002\u4f46\u5728\u6279\u5904\u7406\u4e0a\u4e0b\u6587\u4e2d\u652f\u6301 `previous_thread_event_id` \u6697\u793a\u4e86\u4e0a\u4e0b\u6587\u4f20\u9012\u6216\u67d0\u79cd\u5f62\u5f0f\u7684\u72b6\u6001\u56de\u6eaf\u80fd\u529b\uff0c\u6216\u8005\u6279\u5904\u7406\u5de5\u5177\u73b0\u5728\u80fd\u66f4\u597d\u5730\u5904\u7406 Threads API \u5de5\u4f5c\u6d41\u3002\u7b49\u7b49\uff0c\u770b\u4e0b\u65e7\u7684\u6587\u672c\uff1a\u201cThreads are stateful; batch requests are not.\u201d\uff08Threads \u662f\u6709\u72b6\u6001\u7684\uff1b\u6279\u5904\u7406\u8bf7\u6c42\u4e0d\u662f\u3002\uff09\u5982\u679c\u8be5\u884c\u79fb\u9664\u4e86\uff0c\u8fd9\u8868\u660e Message Batches API \u53ef\u80fd\u5df2\u53d1\u5c55\u4e3a\u5904\u7406 Threads\uff0c\u6216\u8005\u8be5\u9650\u5236\u88ab\u6f84\u6e05/\u79fb\u9664\u4e86\u3002\u9274\u4e8e `store` \u4e5f\u88ab\u79fb\u9664\uff0c\u8fd9\u611f\u89c9\u50cf\u662f\u4e00\u4e2a\u529f\u80fd\u6269\u5c55\u66f4\u65b0\uff0c\u5176\u4e2d\u53d7\u9650\u7684\u529f\u80fd\u5df2\u96c6\u6210\u5230\u6279\u5904\u7406\u8def\u5f84\u4e2d\u3002\n\n4. **\u8d77\u8349\u5206\u6790\uff08\u4e2d\u6587\uff09**\uff1a\n\n    *   **\u603b\u4f53\u6458\u8981**\uff1a\u6587\u6863\u66f4\u65b0\u4e86 Message Batches API \u7684\u517c\u5bb9\u6027\u5217\u8868\u3002\u5b83\u79fb\u9664\u4e86 Threads\uff08`store`\u3001`previous_thread_event_id`\uff09\u3001\u8def\u7531\u63d0\u793a\uff08`cache_hint`\u3001`context_hint`\uff09\u548c\u7814\u7a76\u9884\u89c8\u529f\u80fd\u4e0d\u88ab\u652f\u6301\u7684\u9650\u5236\u3002\u8fd9\u8868\u660e\u8fd9\u4e9b\u529f\u80fd\u73b0\u5728\u53ef\u7528\u4e8e\u6279\u5904\u7406\u3002\n\n    *   **\u5173\u952e\u4e3b\u9898**\uff1a\n        *   **\u529f\u80fd\u6269\u5c55**\uff1aMessage Batches API \u53ef\u80fd\u73b0\u5728\u652f\u6301\u72b6\u6001\u7ba1\u7406\u548c\u9ad8\u7ea7\u8def\u7531\u3002\n        *   **\u7b80\u5316/\u6e05\u6670\u5316**\uff1a\u6587\u6863\u91cd\u70b9\u8f6c\u79fb\u5230\u4ec5\u5269\u7684\u6838\u5fc3\u9650\u5236\uff08\u6d41\u5f0f\u4f20\u8f93\u3001\u901f\u5ea6\u3001token \u9650\u5236\uff09\u3002\n        *   **Threads \u96c6\u6210**\uff1a\u5173\u4e8e Threads \u4e0d\u53ef\u7528\u7684\u9650\u5236\u5df2\u79fb\u9664\u3002\n\n    *   **\u5f71\u54cd\u7ea7\u522b**\uff1a**Medium**\uff08\u4e2d\u7b49\uff09\u3002\u8fd9\u4e0d\u662f\u7834\u574f\u6027\u53d8\u66f4\uff0c\u4f46\u5b83\u4e3a\u6279\u5904\u7406\u5de5\u4f5c\u6d41\u663e\u8457\u89e3\u9501\u4e86\u65b0\u80fd\u529b\uff08\u7279\u522b\u662f Threads \u548c\u8def\u7531\u63d0\u793a\uff09\u3002\u5f00\u53d1\u8005\u73b0\u5728\u53ef\u4ee5\u6784\u5efa\u66f4\u590d\u6742\u7684\u6279\u5904\u7406\u6d41\u6c34\u7ebf\u3002\n\n    *   **\u884c\u52a8\u4e8b\u9879**\uff1a\n        *   \u66f4\u65b0\u6279\u5904\u7406\u4ee3\u7801\u4ee5\u5c1d\u8bd5\u4f7f\u7528 `store` \u6216 Threads \u76f8\u5173\u53c2\u6570\u3002\n        *   \u5982\u679c\u4f7f\u7528\u81ea\u5b9a\u4e49\u8def\u7531\uff0c\u5229\u7528 `cache_hint` / `context_hint` \u8fdb\u884c\u6279\u5904\u7406\u3002\n        *   \u5982\u9002\u7528\uff0c\u5728\u65b0\u6279\u5904\u7406\u4e2d\u6d4b\u8bd5\u7814\u7a76\u9884\u89c8\u529f\u80fd\u3002\n\n5. **\u4f18\u5316\u8bed\u8a00\uff08\u4e2d\u6587\uff09**\uff1a\n\n    *   *\u6458\u8981*\uff1a\u6587\u6863\u66f4\u65b0\u4e86 Message Batches API \u7684\u529f\u80fd\u517c\u5bb9\u6027\u5217\u8868\uff0c\u79fb\u9664\u4e86\u5173\u4e8e Threads\u3001\u8def\u7531\u63d0\u793a\u548c\u7814\u7a76\u9884\u89c8\u529f\u80fd\u7684\u9650\u5236\u8bf4\u660e\u3002\u8fd9\u6697\u793a\u8fd9\u4e9b\u529f\u80fd\u73b0\u5728\u53ef\u80fd\u5df2\u652f\u6301\u6279\u5904\u7406\u3002\n    *   *\u4e3b\u9898*\uff1a\u529f\u80fd\u517c\u5bb9\u6027\u6269\u5c55, \u9650\u5236\u6761\u4ef6\u7b80\u5316, Threads \u96c6\u6210.\n    *   *\u5f71\u54cd*\uff1aMedium. \u867d\u7136\u4e0d\u662f\u7834\u574f\u6027\u53d8\u66f4\uff0c\u4f46\u89e3\u9501\u4e86\u65b0\u7684\u6279\u5904\u7406\u80fd\u529b\uff0c\u7279\u522b\u662f\u5bf9\u72b6\u6001\u7ba1\u7406\u548c\u8def\u7531\u4f18\u5316\u7684\u652f\u6301\u3002\n    *   *\u884c\u52a8*\uff1a\u5ba1\u67e5\u73b0\u6709\u7684\u6279\u5904\u7406\u4ee3\u7801\uff0c\u63a2\u7d22\u5728\u6279\u5904\u7406\u4e2d\u4f7f\u7528 `store` \u53c2\u6570\u6216 Threads \u529f\u80fd\u3002\u5229\u7528 `cache_hint`/`context_hint` \u4f18\u5316\u6279\u5904\u7406\u8c03\u5ea6\u3002\u6d4b\u8bd5\u7814\u7a76\u9884\u89c8\u529f\u80fd\u5728\u6279\u5904\u7406\u4e2d\u7684\u8868\u73b0\u3002\n\n6. **\u6700\u7ec8\u6da6\u8272**\uff1a\u786e\u4fdd\u8bed\u6c14\u4e13\u4e1a\u4e14\u5bf9\u5f00\u53d1\u8005\u6709\u5e2e\u52a9\u3002\n\n    *   *\u81ea\u6211\u4fee\u6b63*\uff1a\u8bf4\u5b83\u4eec*\u5df2\u652f\u6301*\u662f\u5426\u5b89\u5168\uff1f\u4ece\u9650\u5236\u5217\u8868\u4e2d\u79fb\u9664\u662f\u5217\u51fa\u529f\u80fd*\u73b0\u5728\u53ef\u7528*\u6216\u4e4b\u524d\u5b8c\u5168\u53d7\u9650\u7684\u67d0\u4e9b\u529f\u80fd\u7684*\u9650\u5236\u5df2\u79fb\u9664*\u7684\u6700\u5408\u903b\u8f91\u7684\u63a8\u65ad\u3002\u6211\u5c06\u8868\u8ff0\u4e3a\u201c\u6697\u793a\u652f\u6301\u201d\u6216\u201c\u79fb\u9664\u9650\u5236\u201d\uff0c\u8fd9\u5728\u6280\u672f\u4e0a\u66f4\u52a0\u5b89\u5168\uff0c\u4f46\u5728\u529f\u80fd\u4e0a\u5bf9\u5f00\u53d1\u8005\u610f\u5473\u7740\u540c\u6837\u7684\u4e8b\u60c5\u3002\n\n    *   \u8ba9\u6211\u4eec\u68c0\u67e5\u5220\u9664\u7684\u5177\u4f53\u884c\uff1a\n        *   `store` / `previous_thread_event_id` (Threads)\n        *   `cache_hint` / `context_hint`\n        *   `research_preview_2026_02: \"active\"`\n\n    \u8fd9\u4e9b\u539f\u672c\u5728\u8868\u683c\u7684\u201c\u9650\u5236\u201d\u90e8\u5206\u3002\u4ece\u90a3\u91cc\u79fb\u9664\u5f3a\u70c8\u6697\u793a API \u73b0\u5728\u652f\u6301\u5b83\u4eec\u3002\n\n    \u8ba9\u6211\u4eec\u6784\u5efa\u6700\u7ec8\u8f93\u51fa\u3002\n\n    **\u7ed3\u6784**\uff1a\n    ### 1. Overall Summary\n    ### 2. Key Themes\n    ### 3. Impact Level\n    ### 4. Action Items\n\n    \uff08\u6309\u8981\u6c42\u7ffb\u8bd1\u6210\u4e2d\u6587\uff09\u3002"}]}